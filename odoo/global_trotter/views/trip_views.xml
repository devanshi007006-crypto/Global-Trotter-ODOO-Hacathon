<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip Kanban View -->
    <record id="view_gt_trip_kanban" model="ir.ui.view">
        <field name="name">gt.trip.kanban</field>
        <field name="model">gt.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name"/>
                <field name="destination"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days"/>
                <field name="budget_total"/>
                <field name="budget_spent"/>
                <field name="budget_remaining"/>
                <field name="budget_status"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-3 shadow-sm rounded border">
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title text-primary fs-5"><field name="name"/></strong>
                                    <div class="text-muted"><i class="fa fa-map-marker text-danger"/> <field name="destination"/></div>
                                </div>
                                <span t-attf-class="badge rounded-pill #{record.budget_status.raw_value == 'on_track' ? 'bg-success' : (record.budget_status.raw_value == 'warning' ? 'bg-warning text-dark' : 'bg-danger')}">
                                    <field name="budget_status"/>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-calendar"/> <field name="start_date"/> to <field name="end_date"/> (<field name="duration_days"/> days)</div>
                                <div class="mt-2">
                                    <strong>Budget: </strong><field name="budget_spent"/> / <field name="budget_total"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Trip Tree View -->
    <record id="view_gt_trip_tree" model="ir.ui.view">
        <field name="name">gt.trip.tree</field>
        <field name="model">gt.trip</field>
        <field name="arch" type="xml">
            <tree string="Trips">
                <field name="name"/>
                <field name="destination"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days"/>
                <field name="num_travelers"/>
                <field name="budget_total" widget="monetary"/>
                <field name="budget_spent" widget="monetary"/>
                <field name="budget_remaining" widget="monetary"/>
                <field name="budget_status" widget="badge" decoration-success="budget_status == 'on_track'" decoration-warning="budget_status == 'warning'" decoration-danger="budget_status == 'exceeded'"/>
                <field name="status" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Trip Form View -->
    <record id="view_gt_trip_form" model="ir.ui.view">
        <field name="name">gt.trip.form</field>
        <field name="model">gt.trip</field>
        <field name="arch" type="xml">
            <form string="GlobalTrotter Trip Workspace">
                <header>
                    <button name="action_generate_days" string="📅 Generate Days" type="object" class="oe_highlight"/>
                    <button name="action_optimize_trip" string="🚀 What-If? Budget Optimizer" type="object" class="btn-warning"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,planned,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Paris Summer Getaway 2026"/>
                        </h1>
                        <h3>
                            <i class="fa fa-map-marker text-danger"/> <field name="destination" placeholder="Destination (e.g. Paris, France)"/>
                        </h3>
                    </div>
                    <group>
                        <group string="📅 Schedule &amp; Travelers">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days"/>
                            <field name="num_travelers"/>
                            <field name="traveler_ids" widget="many2many_tags" placeholder="Select or invite friends..."/>
                        </group>
                        <group string="💰 Budget Tracker">
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_total" widget="monetary"/>
                            <field name="budget_spent" widget="monetary"/>
                            <field name="budget_remaining" widget="monetary"/>
                            <field name="budget_status" widget="badge" decoration-success="budget_status == 'on_track'" decoration-warning="budget_status == 'warning'" decoration-danger="budget_status == 'exceeded'"/>
                            <field name="travel_style"/>
                            <field name="interests"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="🗓️ Day-wise Itinerary" name="itinerary">
                            <field name="day_ids">
                                <tree editable="bottom">
                                    <field name="day_number"/>
                                    <field name="date"/>
                                    <field name="title"/>
                                    <field name="day_cost" widget="monetary"/>
                                </tree>
                            </field>
                        </page>

                        <page string="💳 Group Expenses &amp; Splits" name="expenses">
                            <field name="expense_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="paid_by_id"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="split_type"/>
                                </tree>
                            </field>
                        </page>

                        <page string="💸 Debt Balancer ('Who Owes Whom')" name="debt_balancer">
                            <div class="alert alert-info" role="alert">
                                <strong>Smart Debt Equalizer:</strong> Automatically calculates group settlements to minimize bank transfers.
                            </div>
                            <field name="debt_summary" widget="html" readonly="1"/>
                        </page>

                        <page string="📝 Notes &amp; Logistics" name="notes">
                            <field name="notes" placeholder="Flight details, hotel confirmations, emergency contacts..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Trip Action -->
    <record id="action_gt_trip" model="ir.actions.act_window">
        <field name="name">GlobalTrotter Trips</field>
        <field name="res_model">gt.trip</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first GlobalTrotter Trip!
            </p>
            <p>
                Manage your itineraries, smart budgets, group split expenses, and AI optimizations all in one unified Odoo workspace.
            </p>
        </field>
    </record>
</odoo>
