<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Itinerary Day Form View -->
    <record id="view_gt_itinerary_day_form" model="ir.ui.view">
        <field name="name">gt.itinerary.day.form</field>
        <field name="model">gt.itinerary.day</field>
        <field name="arch" type="xml">
            <form string="Itinerary Day Details">
                <sheet>
                    <group>
                        <group>
                            <field name="trip_id"/>
                            <field name="day_number"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="title"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="day_cost" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Activities">
                            <field name="activity_ids">
                                <tree editable="bottom">
                                    <field name="start_time"/>
                                    <field name="name"/>
                                    <field name="category"/>
                                    <field name="duration_hours"/>
                                    <field name="cost" widget="monetary"/>
                                    <field name="rating"/>
                                    <field name="is_indoor"/>
                                    <field name="vote_score"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Day Notes">
                            <field name="notes" placeholder="Day highlights, travel routes, tips..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Activity Tree View -->
    <record id="view_gt_activity_tree" model="ir.ui.view">
        <field name="name">gt.activity.tree</field>
        <field name="model">gt.activity</field>
        <field name="arch" type="xml">
            <tree string="All Activities">
                <field name="trip_id"/>
                <field name="itinerary_day_id"/>
                <field name="start_time"/>
                <field name="name"/>
                <field name="category"/>
                <field name="cost" widget="monetary"/>
                <field name="rating"/>
                <field name="is_indoor"/>
                <field name="vote_score"/>
            </tree>
        </field>
    </record>

    <!-- Itinerary Day Action -->
    <record id="action_gt_itinerary_day" model="ir.actions.act_window">
        <field name="name">Itinerary Days</field>
        <field name="res_model">gt.itinerary.day</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Activity Action -->
    <record id="action_gt_activity" model="ir.actions.act_window">
        <field name="name">Activities Master</field>
        <field name="res_model">gt.activity</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
